<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:layout_margin="6dp"
    android:background="@drawable/voting_card_bg"
    android:padding="12dp"
    android:clickable="true"
    android:focusable="true">


    <TextView
        android:id="@+id/tvPlayerName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="PLAYER 1"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold|italic"
        android:fontFamily="@font/bangers_regular"
        android:letterSpacing="0.04"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/imgVotedStatus" />


    <ImageView
        android:id="@+id/imgPlayerAvatar"
        android:layout_width="36dp"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/av1"
        app:layout_constraintTop_toBottomOf="@id/tvPlayerName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />


    <ImageView
        android:id="@+id/imgVotedStatus"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_check_circle"
        app:tint="#00FF88"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
